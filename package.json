{
  "name": "ancient-book-lib",
  "version": "1.4.5",
  "private": true,
  "description": "古籍通 AncientBook 开源古籍文献检索阅读平台（纯静态无数据库架构）",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/generate-sitemap.mjs",
    "start": "next start",
    "lint": "next lint",
    "build:catalog": "node scripts/build-daizhige-catalog.mjs",
    "build:fulltext": "tsx scripts/build-fulltext-index.mjs",
    "build:characters": "node scripts/build-characters.mjs",
    "build:book-samples": "node scripts/build-book-samples.mjs",
    "test": "tsx --test test/*.test.ts",
    "export": "next build && next export",
    "build:cbdb": "node scripts/build-cbdb-index.mjs",
    "build:cbdb-rel": "node scripts/build-cbdb-relations.mjs",
    "build:cbdb-offices": "node scripts/build-cbdb-offices.mjs",
    "build:cbdb-analysis": "node scripts/build-cbdb-analysis.mjs",
    "build:cbdb-altnames": "node scripts/build-cbdb-altnames.mjs",
    "build:cbdb-entry": "node scripts/build-cbdb-entry.mjs",
    "build:cbdb-sources": "node scripts/build-cbdb-sources.mjs"
  },
  "dependencies": {
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "better-sqlite3": "^13.0.3",
    "tsx": "^4.23.13",
    "typescript": "^5.5.0"
  }
}
