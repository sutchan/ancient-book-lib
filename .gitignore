# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 古籍索引大文件（5GB源文本不入库，索引若超限可git lfs或独立托管）
*.txt.bak
/scripts/tmp/
/tmp/

# 构建期生成的全文索引与章节分片清单（体积大，由 build:fulltext 在 CI/部署时生成，不入库）
/public/index/fulltext-index.json
/public/index/chapters.json

# 构建期生成的缓存键指纹（由 build:catalog 写入，仅作 CI 缓存键使用）
/public/index/catalog-fingerprint.json

# 本地开发记忆（.codebuddy 与 .workbuddy 互为符号链接，两者都必须忽略，
# 否则 git 会穿过链接把本地会话记忆提交进公开仓库）
.codebuddy
.workbuddy

# 根目录一次性临时脚本（scripts/*.cjs 为正式工具，仍应入库，故只忽略根级 _tmp_*）
/_tmp_*.cjs
